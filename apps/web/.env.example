# Local dev overrides for apps/web — copy this file to `.env.local` and customize.
# `.env.local` is gitignored; `.env.example` is the committed template.

# Vite dev server bind address.
#   - unset (default) → binds to `localhost` only (safest; works for local dev on the same machine)
#   - `true`          → binds to all interfaces (0.0.0.0) — required when accessing the dev server
#                        through a reverse proxy, a remote dev env (Coder, Gitpod, codespaces), or another machine on the LAN
#   - any other value → used as the bind address literally (e.g. `127.0.0.1`, `192.168.1.10`)
# VITE_HOST=true

# Comma-separated list of hostnames Vite will accept Host-header requests from.
# Required by Vite's host check when serving through a reverse proxy or custom domain.
# Leading `.` matches any subdomain (e.g. `.example.com` accepts `foo.example.com` and `example.com`).
# VITE_ALLOWED_HOSTS=my-dev.example.com,.example.com
