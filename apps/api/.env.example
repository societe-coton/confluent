# Confluent API — environment template.
# Copy to `.env` for local dev. Override per environment in Coolify for staging/prod.

# Postgres
DATABASE_URL=postgresql://confluent_dev_user:CHANGE_ME@postgres:5432/confluent_dev

# HTTP
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# -------- SMTP --------
# Dev local (Mailhog : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@confluent.local

# Prod : Brevo SMTP relay (override via Coolify, NE PAS commiter de creds réels)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<login Brevo, généralement l'email du compte>
# SMTP_PASSWORD=<clé SMTP générée dans Brevo > SMTP & API>
# SMTP_FROM=<expéditeur vérifié dans Brevo > Senders>

# JWT (32+ bytes recommandés)
JWT_SECRET=dev-secret-change-me-32-bytes-minimum-abc
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-bytes-abc

# Storage S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=confluent-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
